{
  "name": "math-modeling-workbench",
  "version": "0.1.0",
  "description": "Windows-first desktop workbench for mathematical modeling competitions.",
  "author": "kstt",
  "private": true,
  "type": "module",
  "main": "electron/bootstrap.cjs",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:web\" \"npm:dev:electron\"",
    "dev:web": "vite --host 127.0.0.1",
    "dev:electron": "wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .",
    "build": "vite build",
    "protect:runtime": "node scripts/build-protected-runtime.cjs",
    "preview": "vite preview --host 127.0.0.1",
    "capture": "npm run build && electron electron/capture.cjs",
    "qa:electron": "npm run build && electron electron/qa.cjs",
    "test": "node --test tests/*.test.cjs",
    "sign:manifest": "node scripts/sign-runtime-manifest.cjs",
    "verify:runtime": "node scripts/verify-runtime.cjs",
    "verify:package": "node scripts/verify-package.cjs",
    "verify:installer": "node scripts/verify-installer.cjs",
    "smoke:package": "node scripts/smoke-package.cjs",
    "smoke:installer": "node scripts/smoke-installer.cjs",
    "build:installer": "node scripts/build-modular-installer.cjs",
    "test:protected-worker": "cross-env SPREADSHEET_WORKER_PATH=electron/protected/spreadsheet-worker.cjs node --test tests/spreadsheet-worker.test.cjs",
    "dist:dir": "npm run build && npm run verify:runtime && npm run protect:runtime && npm run test:protected-worker && electron-builder --dir && npm run verify:package",
    "dist:win": "npm run dist:dir && npm run build:installer && npm run verify:installer"
  },
  "dependencies": {
    "bytenode": "^1.6.0",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@uiw/react-codemirror": "^4.25.2",
    "@vitejs/plugin-react": "5.0.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^43.2.0",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.28.1",
    "exceljs": "^4.4.0",
    "lucide-react": "^0.468.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-markdown": "^10.1.0",
    "vite": "^6.4.3",
    "wait-on": "^8.0.2",
    "yaml": "^2.7.0"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  },
  "build": {
    "appId": "cn.modeling.workbench",
    "productName": "数模工坊",
    "directories": {
      "output": "release"
    },
    "asar": true,
    "files": [
      "dist/**/*",
      "electron/bootstrap.cjs",
      "electron/preload.cjs",
      "electron/protected/loader.jsc",
      "electron/protected/runtime.bin",
      "electron/protected/spreadsheet-worker.cjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "runtime/THIRD_PARTY_NOTICES.txt",
        "to": "runtime/THIRD_PARTY_NOTICES.txt"
      },
      {
        "from": "runtime/guard",
        "to": "runtime/guard"
      }
    ],
    "publish": [
      {
        "provider": "generic",
        "url": "https://dl.example.com/mmw/${channel}/"
      }
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    },
    "win": {
      "icon": "build/app-icon.ico",
      "signingHashAlgorithms": ["sha256"]
    }
  }
}
