{
  "port": 8788,
  "upstream": "http://127.0.0.1:8080",
  "publicBaseUrl": "https://gw.example.com",
  "portal": "https://portal.example.com",
  "tokenSecret": "change-me-32-bytes-minimum-secret",
  "keySecret": "change-me-another-32-bytes-secret",
  "accessTokenTtlSeconds": 900,
  "requestTimeoutMs": 600000,
  "maxBodyBytes": 8388608,
  "operations": {
    "rateLimit": {
      "windowMs": 60000,
      "maxRequests": 30,
      "maxTrackedDevices": 10000
    },
    "admission": {
      "maxConcurrent": 4,
      "maxQueued": 24,
      "queueTimeoutMs": 300000
    },
    "shutdownGraceMs": 30000,
    "metrics": {
      "enabled": false,
      "path": "/metrics",
      "token": ""
    }
  },
  "imageEnabled": true,
  "maxImagesPerStage": 1,
  "tiers": [
    {
      "id": "standard",
      "label": "标准",
      "models": {
        "reasoning": "gpt-5.6-sol",
        "writing": "gpt-5.6-sol",
        "image": "gpt-image-2"
      }
    }
  ],
  "defaultTiers": {
    "reasoning": "standard",
    "writing": "standard",
    "image": "standard"
  },
  "sub2api": {
    "loginPath": "/api/v1/auth/login",
    "profilePath": "/api/v1/user/profile",
    "usagePath": "/api/v1/usage/dashboard/stats",
    "usageListPath": "/api/v1/usage",
    "apiKeysPath": "/api/v1/keys",
    "topUpPath": "/purchase",
    "topUpEnabled": false
  }
}
