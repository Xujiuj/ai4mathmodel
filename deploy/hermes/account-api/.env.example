POSTGRES_DB=modeling_accounts
POSTGRES_USER=modeling_accounts
POSTGRES_PASSWORD=replace-with-random-postgres-password
# Required separately: POSTGRES_IMAGE must match <registry>/<image>@sha256:<64 hex chars>.
# The compose-only account-postgres host is private and may omit sslmode. For any
# remote PostgreSQL host, append ?sslmode=verify-full (or sslmode=require at minimum).
DATABASE_URL=postgresql://modeling_accounts:replace-with-random-postgres-password@account-postgres:5432/modeling_accounts
ACCOUNT_API_PORT=18090
# Direct launches default to 127.0.0.1; Compose overrides this inside the container.
ACCOUNT_API_BIND_HOST=127.0.0.1
ACCOUNT_API_SERVICE_TOKEN=replace-with-a-shared-random-token-at-least-32-characters
ACCOUNT_API_FIXED_RUN_CREDITS=2000
ACCOUNT_API_CREDITS_PER_USD=7200
# Keep public signup grants disabled unless an abuse-controlled campaign explicitly enables them.
ACCOUNT_API_SIGNUP_GRANT_CREDITS=0
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-random-password
# Optional: only these direct proxy peer IPs may supply one validated X-Forwarded-For value.
# ACCOUNT_API_TRUSTED_PROXY_IPS=127.0.0.1,::1
